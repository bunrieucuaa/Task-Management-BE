generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ActivityLog {
  id        Int       @id @default(autoincrement())
  taskId    Int?      @map("task_id")
  userId    Int?      @map("user_id")
  action    String?   @db.VarChar(100)
  oldValue  Json?     @map("old_value")
  newValue  Json?     @map("new_value")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User?     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("activity_logs")
}

model AiHistory {
  id         Int            @id @default(autoincrement())
  taskId     Int?           @map("task_id")
  userId     Int?           @map("user_id")
  actionType AiActionType?  @map("action_type")
  prompt     String?
  response   String?
  createdAt  DateTime?      @default(now()) @map("created_at") @db.Timestamp(6)
  task       Task?          @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user       User?          @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("ai_histories")
}

model ProjectMember {
  id        Int       @id @default(autoincrement())
  projectId Int?      @map("project_id")
  userId    Int?      @map("user_id")
  role      String?   @db.VarChar(50)
  joinedAt  DateTime? @default(now()) @map("joined_at") @db.Timestamp(6)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Project {
  id          Int             @id @default(autoincrement())
  name        String          @db.VarChar(255)
  description String?
  ownerId     Int?            @map("owner_id")
  status      ProjectStatus?  @default(ACTIVE)
  createdAt   DateTime?       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime?       @default(now()) @map("updated_at") @db.Timestamp(6)
  members     ProjectMember[]
  owner       User?           @relation(fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tasks       Task[]

  @@map("projects")
}

model Tag {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(100)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  taskTags  TaskTag[]

  @@map("tags")
}

model TaskAttachment {
  id         Int       @id @default(autoincrement())
  taskId     Int?      @map("task_id")
  fileUrl    String    @map("file_url")
  uploadedBy Int?      @map("uploaded_by")
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  uploader   User?     @relation(fields: [uploadedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("task_attachments")
}

model TaskComment {
  id        Int       @id @default(autoincrement())
  taskId    Int?      @map("task_id")
  userId    Int?      @map("user_id")
  content   String
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User?     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([taskId], map: "idx_comments_task")
  @@map("task_comments")
}

model TaskTag {
  id     Int   @id @default(autoincrement())
  taskId Int?  @map("task_id")
  tagId  Int?  @map("tag_id")
  tag    Tag?  @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  task   Task? @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([taskId, tagId])
  @@map("task_tags")
}

model Task {
  id          Int              @id @default(autoincrement())
  title       String           @db.VarChar(255)
  description String?
  projectId   Int?             @map("project_id")
  creatorId   Int?             @map("creator_id")
  assigneeId  Int?             @map("assignee_id")
  status      TaskStatus?      @default(TODO)
  priority    TaskPriority?    @default(MEDIUM)
  deadline    DateTime?        @db.Timestamp(6)
  createdAt   DateTime?        @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime?        @default(now()) @map("updated_at") @db.Timestamp(6)
  logs        ActivityLog[]
  aiHistories AiHistory[]
  attachments TaskAttachment[]
  comments    TaskComment[]
  tags        TaskTag[]
  assignee    User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator     User?            @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([assigneeId], map: "idx_tasks_assignee")
  @@index([projectId], map: "idx_tasks_project")
  @@index([status], map: "idx_tasks_status")
  @@map("tasks")
}

model User {
  id                 Int              @id @default(autoincrement())
  name               String           @db.VarChar(100)
  email              String           @unique @db.VarChar(255)
  passwordHash       String           @map("password_hash")
  passwordSalt       String           @map("password_salt")
  tokenVersion       Int              @default(0) @map("token_version")
  mustChangePassword Boolean          @default(true) @map("must_change_password")
  avatarUrl          String?          @map("avatar_url")
  role               UserRole?        @default(MEMBER)
  status             UserStatus?      @default(ACTIVE)
  createdAt          DateTime?        @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime?        @updatedAt @map("updated_at") @db.Timestamp(6)
  activityLogs       ActivityLog[]
  aiHistories        AiHistory[]
  projectMembers     ProjectMember[]
  ownedProjects      Project[]
  attachments        TaskAttachment[]
  comments           TaskComment[]
  assignedTasks      Task[]           @relation("TaskAssignee")
  createdTasks       Task[]           @relation("TaskCreator")

  @@index([status])
  @@index([role])
  @@index([status, role])
  @@index([createdAt])
  @@map("users")
}

enum AiActionType {
  GENERATE_SUBTASKS
  SUMMARIZE_TASK
  SUGGEST_PRIORITY
  SUGGEST_DEADLINE

  @@map("ai_action_type")
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED

  @@map("project_status")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("task_priority")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  CANCELLED

  @@map("task_status")
}

enum UserRole {
  ADMIN
  MEMBER

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED

  @@map("user_status")
}
