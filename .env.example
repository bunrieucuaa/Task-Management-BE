# Server Configuration
PORT=8080
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# JWT Configuration
# BẮT BUỘC. Chuỗi ngẫu nhiên >= 32 ký tự. App sẽ fail-fast nếu thiếu/yếu.
# Sinh nhanh: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS — danh sách origin FE được phép, phân tách bằng dấu phẩy
# Vd production: https://app.example.com,https://admin.example.com
CORS_ORIGIN=http://localhost:5173
